{
  // Type-aware linting is on through `--type-aware` and the editor's `oxc.typeAware`. oxlint
  // accepts `options.typeAware` only in a root config, and an editor opened on a parent
  // directory reads this file as nested.
  // `check:codegen` compares the generated GraphQL types byte for byte.
  "ignorePatterns": ["src/clients/github/graphql/"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    // no-unnecessary-condition needs noUncheckedIndexedAccess, or it reads every guard against
    // a missing element as dead code.
    "nursery": "error",
  },
  "rules": {
    "capitalized-comments": ["error", "always", { "ignoreConsecutiveComments": true }],
    // Return types check what a function returns. The rule fails a generator that returns
    // `yield*` of a failure on one path, as `missingReturnYieldStar` asks, and nothing on another.
    "consistent-return": "off",
    "explicit-function-return-type": "off",
    // Effect.gen takes an anonymous generator.
    "func-names": "off",
    "id-length": "off",
    // unicorn/no-useless-undefined bans `let x: T | undefined = undefined`, and this rule bans
    // `let x: T | undefined;`. The compiler still fails a read before assignment.
    "init-declarations": "off",
    // Tagged errors live beside the program that fails with them.
    "max-classes-per-file": "off",
    "max-lines-per-function": "off",
    "max-statements": "off",
    // Effect's factories are capitalized plain calls: Schema.Struct, Data.TaggedError.
    "new-cap": ["error", { "capIsNew": false }],
    "no-async-await": "off",
    // tsc fails `&` typed for `&&` where a boolean is expected, and bit-flag tests need `&`.
    "no-bitwise": "off",
    "no-magic-numbers": "off",
    // Its fix mutates in place, which readonly types forbid, and a hand-rebuilt object drops
    // whatever it forgets.
    "no-map-spread": "off",
    "no-optional-chaining": "off",
    // tsc fails a value declared twice, and this rule also fails `const User` beside `type User`.
    "no-redeclare": "off",
    "no-rest-spread-properties": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "importNames": ["jest", "mock", "spyOn"],
            "message": "Use a fake, injected through a layer or a parameter (testing.md).",
            "name": "bun:test",
          },
        ],
      },
    ],
    // A restriction without an object also catches a matcher behind `.not` or `expect.soft`.
    "no-restricted-properties": [
      "error",
      {
        "message": "Compare the whole value with toStrictEqual, and match only the fields that vary (testing.md).",
        "property": "toMatchObject",
      },
      {
        "message": "Compare the whole value with toStrictEqual, and match only the fields that vary (testing.md).",
        "property": "objectContaining",
      },
      {
        "message": "Compare the whole value with toStrictEqual, and match only the fields that vary (testing.md).",
        "property": "arrayContaining",
      },
      {
        "message": "Compare with toStrictEqual, which also checks undefined fields and class types (testing.md).",
        "property": "toEqual",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenCalled",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenCalledOnce",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toBeCalled",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toBeCalledTimes",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toBeCalledWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "lastCalledWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "nthCalledWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenCalledTimes",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenCalledWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenLastCalledWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenNthCalledWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveLastReturnedWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveNthReturnedWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveReturned",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveReturnedTimes",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveReturnedWith",
      },
      {
        "message": "Use a fake, injected through a layer or a parameter (testing.md).",
        "object": "vi",
        "property": "doMock",
      },
      {
        "message": "Use a fake, injected through a layer or a parameter (testing.md).",
        "object": "vi",
        "property": "fn",
      },
      {
        "message": "Use a fake, injected through a layer or a parameter (testing.md).",
        "object": "vi",
        "property": "mock",
      },
      {
        "message": "Use a fake, injected through a layer or a parameter (testing.md).",
        "object": "vi",
        "property": "spyOn",
      },
    ],
    "no-ternary": "off",
    // Reads no environment, so every hit is a platform global; tsc has the lib.
    "no-undef": "off",
    "no-undefined": "off",
    "no-unmodified-loop-condition": ["error", { "checkConditionalExpressions": true }],
    // With func-style, one of two arrows that call each other reads the other before its
    // declaration. A use in a function body runs later, and one in the same scope still fails.
    "no-use-before-define": ["error", { "variables": false }],
    // A `void` statement is how no-floating-promises leaves a promise unawaited on purpose.
    "no-void": ["error", { "allowAsStatement": true }],
    "no-warning-comments": "off",
    "one-var": ["error", "never"],
    // promise-function-async makes a promise-returning method async, and return-await bans
    // awaiting its return. This rule then fails the method for having no await, and
    // typescript/require-await accepts it.
    "require-await": "off",
    "sort-imports": "off",
    // noPropertyAccessFromIndexSignature requires brackets on an index signature.
    "typescript/dot-notation": ["error", { "allowIndexSignaturePropertyAccess": true }],
    "typescript/no-empty-interface": ["error", { "allowSingleExtends": true }],
    "typescript/no-empty-object-type": ["error", { "allowInterfaces": "with-single-extends" }],
    // It asks for `x!`, which no-non-null-assertion bans.
    "typescript/non-nullable-type-assertion-style": "off",
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "name": [
              "Brand",
              "ChildProcessHandle",
              "Command",
              "Context",
              "Effect",
              "HttpClientRequest",
              "HttpClientResponse",
              "Layer",
              "Option",
              "Redacted",
              "Ref",
              "Top",
            ],
            "package": "effect",
          },
          { "from": "package", "name": ["Buffer", "Server"], "package": "@types/node" },
          // Intersections with a conditional type, which the rule can't resolve.
          "GraphqlDataSchema",
          "ResponseSchema",
          // Readonly fields that hold effects, which the rule allows only at the top level.
          { "from": "file", "name": "SetupStep", "path": "src/cli/gh/setup.ts" },
        ],
        // The callee types an inferred parameter.
        "ignoreInferredTypes": true,
      },
    ],
    "typescript/promise-function-async": ["error", { "checkArrowFunctions": false }],
    // Effect schema trees and combinator stacks nest four deep routinely.
    "unicorn/max-nested-calls": ["error", { "max": 5 }],
    // It fails Effect.forEach(items, f) as passing `thisArg`, and no callback here uses `this`.
    "unicorn/no-array-method-this-argument": "off",
    // Which reads better, a fold or a loop, depends on the fold.
    "unicorn/no-array-reduce": "off",
    "unicorn/no-immediate-mutation": "off",
    "unicorn/no-null": "off",
    // Skipped holes read as well as an index, and prefer-destructuring bans the index.
    "unicorn/no-unreadable-array-destructuring": "off",
    // no-invalid-void-type bans `void` in type arguments, so a promise with no value resolves
    // with an explicit `undefined` argument.
    "unicorn/no-useless-undefined": ["error", { "checkArguments": false }],
    // oxfmt prints lowercase hexadecimal digits, and this rule has no option to allow them.
    "unicorn/number-literal-case": "off",
    // Its fix inserts a `new` that breaks Schema.TaggedError extends clauses.
    "unicorn/throw-new-error": "off",
  },
}
