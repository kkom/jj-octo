{
  // Type-aware linting is on through `--type-aware` in the lint scripts and `oxc.typeAware` in
  // the editor, not `options.typeAware` here. oxlint accepts that option only in the root
  // config, and an editor opened on a parent directory reads this file as a nested one.
  // GraphQL Code Generator writes this, and `check:codegen` compares it byte for byte.
  "ignorePatterns": ["src/clients/github/graphql/"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    // no-unnecessary-condition here needs noUncheckedIndexedAccess, or it
    // reads every guard against a missing element as dead code.
    "nursery": "error",
  },
  "rules": {
    "capitalized-comments": ["error", "always", { "ignoreConsecutiveComments": true }],
    // A worker's entrypoint and a durable object are classes whose methods the
    // runtime calls on an instance, over RPC, so a method there can't become
    // static or a function, whether or not it reads `this`.
    "class-methods-use-this": "off",
    "explicit-function-return-type": "off",
    // Effect.gen takes an anonymous generator.
    "func-names": "off",
    "id-length": "off",
    // unicorn/no-useless-undefined bans `let x: T | undefined = undefined`, and this
    // rule bans the `let x: T | undefined;` left without it. The compiler still fails
    // a read before the first assignment.
    "init-declarations": "off",
    // Tagged errors live beside the program that fails with them.
    "max-classes-per-file": "off",
    "max-lines-per-function": "off",
    "max-statements": "off",
    // Effect's factories are capitalized plain calls: Schema.Struct, Data.TaggedError.
    "new-cap": ["error", { "capIsNew": false }],
    "no-async-await": "off",
    // It catches `&` typed for `&&`, which tsc already rejects wherever a boolean is
    // expected, and bans the file-mode and bit-flag tests that need the operators.
    "no-bitwise": "off",
    "no-magic-numbers": "off",
    // Its fix is to mutate in place, which the readonly types here forbid, leaving
    // a hand-rebuilt object that drops whatever it forgets.
    "no-map-spread": "off",
    "no-optional-chaining": "off",
    // tsc fails on a name declared twice as a value. This rule also fails on a schema
    // and its type that share one name, as `const User` beside `type User`, which
    // TypeScript allows.
    "no-redeclare": "off",
    "no-rest-spread-properties": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "importNames": ["mock", "spyOn"],
            "message": "Use a fake, injected through a layer or a parameter (testing.md).",
            "name": "bun:test",
          },
        ],
      },
    ],
    // Without an object, a restriction matches the property on any object, so it also
    // catches a matcher behind `.not`, `.resolves` or `expect.soft`.
    "no-restricted-properties": [
      "error",
      {
        "message": "Compare the whole value with toStrictEqual, and match only the fields that vary (testing.md).",
        "property": "toMatchObject",
      },
      {
        "message": "Compare the whole value with toStrictEqual, and match only the fields that vary (testing.md).",
        "property": "objectContaining",
      },
      {
        "message": "Compare the whole value with toStrictEqual, and match only the fields that vary (testing.md).",
        "property": "arrayContaining",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenCalled",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenCalledTimes",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenCalledWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenLastCalledWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenNthCalledWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveLastReturnedWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveNthReturnedWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveReturned",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveReturnedTimes",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveReturnedWith",
      },
      {
        "message": "Use a fake, injected through a layer or a parameter (testing.md).",
        "object": "vi",
        "property": "doMock",
      },
      {
        "message": "Use a fake, injected through a layer or a parameter (testing.md).",
        "object": "vi",
        "property": "fn",
      },
      {
        "message": "Use a fake, injected through a layer or a parameter (testing.md).",
        "object": "vi",
        "property": "mock",
      },
      {
        "message": "Use a fake, injected through a layer or a parameter (testing.md).",
        "object": "vi",
        "property": "spyOn",
      },
    ],
    "no-ternary": "off",
    // Reads no environment, so every hit is a platform global; tsc has the lib.
    "no-undef": "off",
    "no-undefined": "off",
    "no-unmodified-loop-condition": ["error", { "checkConditionalExpressions": true }],
    // With func-style, two functions that call each other are arrows, so one of
    // them reads the other before its declaration. A use inside a function body
    // runs later, and a use in the same scope still fails.
    "no-use-before-define": ["error", { "variables": false }],
    // As a statement, `void` is how no-floating-promises lets a promise go
    // unawaited on purpose.
    "no-void": ["error", { "allowAsStatement": true }],
    "no-warning-comments": "off",
    "one-var": ["error", "never"],
    // With promise-function-async, a method that returns a promise is async,
    // and return-await bans awaiting it on the return. This one fails that method
    // for having no await; typescript/require-await knows a returned promise.
    "require-await": "off",
    "sort-imports": "off",
    // Bracket access is what the compiler requires on an index signature, and the type
    // information tells the rule which reads those are.
    "typescript/dot-notation": ["error", { "allowIndexSignaturePropertyAccess": true }],
    "typescript/no-empty-interface": ["error", { "allowSingleExtends": true }],
    "typescript/no-empty-object-type": ["error", { "allowInterfaces": "with-single-extends" }],
    // It asks for `x!`, which no-non-null-assertion bans.
    "typescript/non-nullable-type-assertion-style": "off",
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "name": [
              "Brand",
              "Command",
              "Context",
              "Effect",
              "HttpClientRequest",
              "HttpClientResponse",
              "Layer",
              "Option",
              "Redacted",
              "Top",
            ],
            "package": "effect",
          },
          { "from": "package", "name": ["Buffer", "Server"], "package": "@types/node" },
          // Intersections with a conditional type, which the rule can't resolve.
          "GraphqlDataSchema",
          "ResponseSchema",
          // Readonly fields that hold effects, which the rule allows only at the top level.
          { "from": "file", "name": "SetupStep", "path": "src/cli/gh/setup.ts" },
        ],
        "ignoreInferredTypes": true,
      },
    ],
    "typescript/promise-function-async": ["error", { "checkArrowFunctions": false }],
    // Effect schema trees and combinator stacks nest four deep routinely.
    "unicorn/max-nested-calls": ["error", { "max": 5 }],
    // It reads any two-argument call of an array method's name as passing
    // `thisArg`, so it fails on Effect.flatMap(effect, f) and
    // Effect.forEach(items, f), which take no `thisArg`. Nothing here passes
    // one, since no callback uses `this`.
    "unicorn/no-array-method-this-argument": "off",
    // A fold and a loop do the same job; which reads better depends on the fold.
    "unicorn/no-array-reduce": "off",
    "unicorn/no-immediate-mutation": "off",
    "unicorn/no-null": "off",
    // Skipped holes read as well as an index, and prefer-destructuring bans the index.
    "unicorn/no-unreadable-array-destructuring": "off",
    // no-invalid-void-type bans `void` in a call's type arguments, so a promise
    // with no value is resolved with `undefined`, which an argument has to name.
    "unicorn/no-useless-undefined": ["error", { "checkArguments": false }],
    // oxfmt prints hexadecimal digits in lowercase and this rule, which takes
    // no option, demands uppercase; the formatter owns a literal's spelling.
    "unicorn/number-literal-case": "off",
    // Its fix inserts a `new` that breaks Schema.TaggedError extends clauses.
    "unicorn/throw-new-error": "off",
  },
}
