{
  // Type-aware linting is on through `--type-aware` in the lint scripts and `oxc.typeAware` in
  // the editor, not `options.typeAware` here. oxlint accepts that option only in the root
  // config, and an editor opened on a parent directory reads this file as a nested one.
  //
  // The lint scripts and the editor run oxlint through `effect-tsgo oxlint`, which adds Effect's
  // rules as the `effecttsgo` plugin. Stock oxlint fails on the plugin's name. Naming `plugins`
  // replaces oxlint's default plugins, so the three defaults are named again.
  "plugins": ["effecttsgo", "oxc", "typescript", "unicorn"],
  // GraphQL Code Generator writes this, and `check:codegen` compares it byte for byte.
  "ignorePatterns": ["src/clients/github/graphql/"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    // no-unnecessary-condition here needs noUncheckedIndexedAccess, or it
    // reads every guard against a missing element as dead code.
    "nursery": "error",
  },
  "rules": {
    "capitalized-comments": ["error", "always", { "ignoreConsecutiveComments": true }],
    // A worker's entrypoint and a durable object are classes whose methods the
    // runtime calls on an instance, over RPC, so a method there can't become
    // static or a function, whether or not it reads `this`.
    "class-methods-use-this": "off",
    "effecttsgo/abort-controller-in-effect": "error",
    "effecttsgo/acquire-release-disposable": "error",
    "effecttsgo/all-of-map-to-for-each": "error",
    "effecttsgo/catch-all-tag-dispatch-to-catch-tag": "error",
    "effecttsgo/catch-all-to-map-error": "error",
    "effecttsgo/catch-chain-to-first-success-of": "error",
    "effecttsgo/catch-die-to-or-die": "error",
    "effecttsgo/catch-if-tag-to-catch-tag": "error",
    "effecttsgo/catch-refail-to-tap-error": "error",
    "effecttsgo/catch-tag-to-catch-reason": "error",
    "effecttsgo/catch-to-or-else-succeed": "error",
    "effecttsgo/catch-unfailable-effect": "error",
    "effecttsgo/class-self-mismatch": "error",
    "effecttsgo/duplicate-package": "error",
    "effecttsgo/effect-do-notation": "error",
    "effecttsgo/effect-fn-iife": "error",
    "effecttsgo/effect-fn-implicit-any": "error",
    "effecttsgo/effect-fn-opportunity": "error",
    "effecttsgo/effect-gen-uses-adapter": "error",
    "effecttsgo/effect-in-failure": "error",
    "effecttsgo/effect-in-void-success": "error",
    "effecttsgo/effect-map-flatten": "error",
    "effecttsgo/effect-map-void": "error",
    "effecttsgo/effect-sleep-zero-to-yield-now": "error",
    "effecttsgo/effect-succeed-with-undefined": "error",
    "effecttsgo/effect-succeed-with-void": "error",
    "effecttsgo/experimental-api-usage": "error",
    "effecttsgo/fail-cause-to-constructor": "error",
    "effecttsgo/flat-map-conditional-to-filter-or-fail": "error",
    "effecttsgo/flat-map-identity-to-flatten": "error",
    "effecttsgo/flat-map-ignored-param-to-and-then": "error",
    "effecttsgo/flat-map-map-to-zip-with": "error",
    "effecttsgo/flat-map-provide-service-to-provide-service-effect": "error",
    "effecttsgo/flat-map-to-map": "error",
    "effecttsgo/flat-map-to-tap": "error",
    "effecttsgo/floating-effect-in-vitest": "error",
    "effecttsgo/for-loop-push-to-for-each": "error",
    "effecttsgo/generic-effect-services": "error",
    "effecttsgo/global-console-in-effect": "error",
    "effecttsgo/global-fetch-in-effect": "error",
    "effecttsgo/global-random-in-effect": "error",
    "effecttsgo/global-timers-in-effect": "error",
    "effecttsgo/instance-of-schema": "error",
    "effecttsgo/layer-merge-all-with-dependencies": "error",
    "effecttsgo/lazy-promise-in-effect-sync": "error",
    "effecttsgo/manual-metric-tap-to-track": "error",
    "effecttsgo/map-const-to-as": "error",
    "effecttsgo/map-map-error-to-map-both": "error",
    "effecttsgo/map-some-catch-no-such-element": "error",
    "effecttsgo/map-some-to-as-some": "error",
    "effecttsgo/match-boolean-to-is-success": "error",
    "effecttsgo/match-effect-to-map-both": "error",
    "effecttsgo/match-effect-to-match": "error",
    "effecttsgo/match-to-result-or-option": "error",
    "effecttsgo/missing-effect-context": "error",
    "effecttsgo/missing-effect-error": "error",
    "effecttsgo/missing-effect-service-dependency": "error",
    "effecttsgo/missing-layer-context": "error",
    "effecttsgo/missing-star-in-yield-effect-gen": "error",
    "effecttsgo/multiple-catch-tag": "error",
    "effecttsgo/new-schema-class": "error",
    "effecttsgo/non-object-effect-service-type": "error",
    "effecttsgo/obsolete-match-import": "error",
    "effecttsgo/obsolete-schema-import": "error",
    "effecttsgo/on-exit-failure-to-on-error": "error",
    "effecttsgo/option-match-to-from-option": "error",
    "effecttsgo/outdated-api": "error",
    "effecttsgo/overridden-schema-constructor": "error",
    "effecttsgo/prefer-barrel-import": "error",
    "effecttsgo/prefer-namespace-import": "error",
    "effecttsgo/prefer-schema-type-property": "error",
    "effecttsgo/prefer-succeed-some-or-none": "error",
    "effecttsgo/prefer-typed-schema-decoder": "error",
    "effecttsgo/prefer-unsafe-constructor": "error",
    "effecttsgo/promise-in-effect-success": "error",
    "effecttsgo/promise-race-in-effect": "error",
    "effecttsgo/provide-layer-succeed-to-provide-service": "error",
    "effecttsgo/provide-merge-all-to-array": "error",
    "effecttsgo/race-first-with-sleep-to-timeout": "error",
    "effecttsgo/redundant-map-error": "error",
    "effecttsgo/redundant-schema-tag-identifier": "error",
    "effecttsgo/result-match-to-from-result": "error",
    "effecttsgo/return-effect-in-gen": "error",
    "effecttsgo/run-of-exit-to-run-exit": "error",
    "effecttsgo/schema-class-missing-brand": "error",
    "effecttsgo/schema-class-object-literal": "error",
    "effecttsgo/schema-literal-non-finite": "error",
    "effecttsgo/schema-number": "error",
    "effecttsgo/schema-opaque-instance-member": "error",
    "effecttsgo/schema-struct-with-tag": "error",
    "effecttsgo/schema-sync-in-effect": "error",
    "effecttsgo/schema-union-of-literals": "error",
    "effecttsgo/scope-in-layer-effect": "error",
    "effecttsgo/service-not-as-class": "error",
    "effecttsgo/suspend-fail-to-fail-sync": "error",
    "effecttsgo/sync-to-succeed": "error",
    "effecttsgo/timeout-catch-tag-to-timeout-or-else": "error",
    "effecttsgo/type-union-to-schema-union": "error",
    "effecttsgo/unnecessary-arrow-block": "error",
    "effecttsgo/unnecessary-effect-gen": "error",
    "effecttsgo/unnecessary-pipe": "error",
    "effecttsgo/unnecessary-pipe-chain": "error",
    "effecttsgo/unnecessary-typeof-type": "error",
    "explicit-function-return-type": "off",
    // Effect.gen takes an anonymous generator.
    "func-names": "off",
    "id-length": "off",
    // unicorn/no-useless-undefined bans `let x: T | undefined = undefined`, and this
    // rule bans the `let x: T | undefined;` left without it. The compiler still fails
    // a read before the first assignment.
    "init-declarations": "off",
    // Tagged errors live beside the program that fails with them.
    "max-classes-per-file": "off",
    "max-lines-per-function": "off",
    "max-statements": "off",
    // Effect's factories are capitalized plain calls: Schema.Struct, Data.TaggedError.
    "new-cap": ["error", { "capIsNew": false }],
    "no-async-await": "off",
    // It catches `&` typed for `&&`, which tsc already rejects wherever a boolean is
    // expected, and bans the file-mode and bit-flag tests that need the operators.
    "no-bitwise": "off",
    "no-magic-numbers": "off",
    // Its fix is to mutate in place, which the readonly types here forbid, leaving
    // a hand-rebuilt object that drops whatever it forgets.
    "no-map-spread": "off",
    "no-optional-chaining": "off",
    // tsc fails on a name declared twice as a value. This rule also fails on a schema
    // and its type that share one name, as `const User` beside `type User`, which
    // TypeScript allows.
    "no-redeclare": "off",
    "no-rest-spread-properties": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "importNames": ["mock", "spyOn"],
            "message": "Use a fake, injected through a layer or a parameter (testing.md).",
            "name": "bun:test",
          },
        ],
      },
    ],
    // Without an object, a restriction matches the property on any object, so it also
    // catches a matcher behind `.not`, `.resolves` or `expect.soft`.
    "no-restricted-properties": [
      "error",
      {
        "message": "Compare the whole value with toStrictEqual, and match only the fields that vary (testing.md).",
        "property": "toMatchObject",
      },
      {
        "message": "Compare the whole value with toStrictEqual, and match only the fields that vary (testing.md).",
        "property": "objectContaining",
      },
      {
        "message": "Compare the whole value with toStrictEqual, and match only the fields that vary (testing.md).",
        "property": "arrayContaining",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenCalled",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenCalledTimes",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenCalledWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenLastCalledWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveBeenNthCalledWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveLastReturnedWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveNthReturnedWith",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveReturned",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveReturnedTimes",
      },
      {
        "message": "Assert on what a fake recorded, such as the messages a fake mailer kept (testing.md).",
        "property": "toHaveReturnedWith",
      },
      {
        "message": "Use a fake, injected through a layer or a parameter (testing.md).",
        "object": "vi",
        "property": "doMock",
      },
      {
        "message": "Use a fake, injected through a layer or a parameter (testing.md).",
        "object": "vi",
        "property": "fn",
      },
      {
        "message": "Use a fake, injected through a layer or a parameter (testing.md).",
        "object": "vi",
        "property": "mock",
      },
      {
        "message": "Use a fake, injected through a layer or a parameter (testing.md).",
        "object": "vi",
        "property": "spyOn",
      },
    ],
    "no-ternary": "off",
    // Reads no environment, so every hit is a platform global; tsc has the lib.
    "no-undef": "off",
    "no-undefined": "off",
    "no-unmodified-loop-condition": ["error", { "checkConditionalExpressions": true }],
    // With func-style, two functions that call each other are arrows, so one of
    // them reads the other before its declaration. A use inside a function body
    // runs later, and a use in the same scope still fails.
    "no-use-before-define": ["error", { "variables": false }],
    // As a statement, `void` is how no-floating-promises lets a promise go
    // unawaited on purpose.
    "no-void": ["error", { "allowAsStatement": true }],
    "no-warning-comments": "off",
    "one-var": ["error", "never"],
    // With promise-function-async, a method that returns a promise is async,
    // and return-await bans awaiting it on the return. This one fails that method
    // for having no await; typescript/require-await knows a returned promise.
    "require-await": "off",
    "sort-imports": "off",
    // Bracket access is what the compiler requires on an index signature, and the type
    // information tells the rule which reads those are.
    "typescript/dot-notation": ["error", { "allowIndexSignaturePropertyAccess": true }],
    "typescript/no-empty-interface": ["error", { "allowSingleExtends": true }],
    "typescript/no-empty-object-type": ["error", { "allowInterfaces": "with-single-extends" }],
    // A runtime's type declarations can declare as classes the values that the runtime makes
    // and that a test's fake stands in for, such as a binding. Code never constructs them, so
    // every value of those types fails this rule.
    "typescript/no-unsafe-class-instance-assignment": "off",
    // It asks for `x!`, which no-non-null-assertion bans.
    "typescript/non-nullable-type-assertion-style": "off",
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "name": [
              "Brand",
              "Command",
              "Context",
              "Effect",
              "HttpClientRequest",
              "HttpClientResponse",
              "Layer",
              "Option",
              "Redacted",
              "Top",
            ],
            "package": "effect",
          },
          { "from": "package", "name": ["Buffer", "Server"], "package": "@types/node" },
          // Intersections with a conditional type, which the rule can't resolve.
          "GraphqlDataSchema",
          "ResponseSchema",
          // Readonly fields that hold effects, which the rule allows only at the top level.
          { "from": "file", "name": "SetupStep", "path": "src/cli/gh/setup.ts" },
        ],
        "ignoreInferredTypes": true,
      },
    ],
    "typescript/promise-function-async": ["error", { "checkArrowFunctions": false }],
    // Effect schema trees and combinator stacks nest four deep routinely.
    "unicorn/max-nested-calls": ["error", { "max": 5 }],
    // It reads any two-argument call of an array method's name as passing
    // `thisArg`, so it fails on Effect.flatMap(effect, f) and
    // Effect.forEach(items, f), which take no `thisArg`. Nothing here passes
    // one, since no callback uses `this`.
    "unicorn/no-array-method-this-argument": "off",
    // A fold and a loop do the same job; which reads better depends on the fold.
    "unicorn/no-array-reduce": "off",
    "unicorn/no-immediate-mutation": "off",
    "unicorn/no-null": "off",
    // Skipped holes read as well as an index, and prefer-destructuring bans the index.
    "unicorn/no-unreadable-array-destructuring": "off",
    // no-invalid-void-type bans `void` in a call's type arguments, so a promise
    // with no value is resolved with `undefined`, which an argument has to name.
    "unicorn/no-useless-undefined": ["error", { "checkArguments": false }],
    // oxfmt prints hexadecimal digits in lowercase and this rule, which takes
    // no option, demands uppercase; the formatter owns a literal's spelling.
    "unicorn/number-literal-case": "off",
    // Its fix inserts a `new` that breaks Schema.TaggedError extends clauses.
    "unicorn/throw-new-error": "off",
  },
  "overrides": [
    {
      // Each of these is not decided yet. A decision fixes what the rule finds, or turns it
      // off with its reason, and moves it out of this block.
      "files": ["**/*"],
      "rules": {
        "effecttsgo/any-unknown-in-error-context": "off",
        "effecttsgo/api-stability-leak": "off",
        "effecttsgo/async-function": "off",
        "effecttsgo/catch-conditional-refail-to-catch-if": "off",
        "effecttsgo/catch-to-ignore": "off",
        "effecttsgo/crypto-random-uuid": "off",
        "effecttsgo/crypto-random-uuid-in-effect": "off",
        "effecttsgo/deterministic-keys": "off",
        "effecttsgo/effect-try-without-catch": "off",
        "effecttsgo/error-payload-shadows-name": "off",
        "effecttsgo/extends-native-error": "off",
        "effecttsgo/floating-effect": "off",
        "effecttsgo/global-console": "off",
        "effecttsgo/global-date": "off",
        "effecttsgo/global-date-in-effect": "off",
        "effecttsgo/global-error-in-effect-catch": "off",
        "effecttsgo/global-error-in-effect-failure": "off",
        "effecttsgo/global-fetch": "off",
        "effecttsgo/global-json": "off",
        "effecttsgo/global-json-in-effect": "off",
        "effecttsgo/global-random": "off",
        "effecttsgo/global-timers": "off",
        "effecttsgo/lazy-effect": "off",
        "effecttsgo/leaking-requirements": "off",
        "effecttsgo/missed-pipeable-opportunity": "off",
        "effecttsgo/missing-concurrency-option": "off",
        "effecttsgo/missing-pipeable-signature": "off",
        "effecttsgo/missing-return-yield-star": "off",
        "effecttsgo/multiple-effect-provide": "off",
        "effecttsgo/nested-effect-gen-yield": "off",
        "effecttsgo/new-promise": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/prefer-effect-array": "off",
        "effecttsgo/prefer-effect-record": "off",
        "effecttsgo/prefer-effect-string": "off",
        "effecttsgo/prefer-schema-over-json": "off",
        "effecttsgo/prefer-schema-tagged-error": "off",
        "effecttsgo/process-env": "off",
        "effecttsgo/process-env-in-effect": "off",
        "effecttsgo/promise-all-in-effect": "off",
        "effecttsgo/redundant-or-die": "off",
        "effecttsgo/run-effect-inside-effect": "off",
        "effecttsgo/schema-sync": "off",
        "effecttsgo/strict-boolean-expressions": "off",
        "effecttsgo/strict-effect-provide": "off",
        "effecttsgo/try-catch-in-effect-gen": "off",
        "effecttsgo/unknown-in-effect-catch": "off",
        "effecttsgo/unnecessary-fail-yieldable-error": "off",
        "effecttsgo/unsafe-effect-type-assertion": "off",
        "effecttsgo/unstable-api-usage": "off",
        "effecttsgo/yield-in-call-argument": "off",
      },
    },
  ],
}
