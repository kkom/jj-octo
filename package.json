{
  "name": "jj-octo",
  "version": "0.11.1",
  "description": "A jj subcommand for GitHub that supports stacked pull requests and works in Claude Code cloud sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkom/jj-octo.git"
  },
  "bin": {
    "jj-octo": "dist/jj-octo.js"
  },
  "files": [
    "dist/jj-octo.js"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --target=bun --outfile dist/jj-octo.js && chmod +x dist/jj-octo.js",
    "compile": "bun build src/main.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/jj-octo",
    "compile:release": "bun scripts/compile-release.ts",
    "check": "bun run --sequential \"check:*\" && bun run test",
    "check:codegen": "graphql-codegen --config codegen.ts --check",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint --type-aware .",
    "check:types": "tsc",
    "fix": "bun run --sequential \"fix:*\"",
    "fix:codegen": "graphql-codegen --config codegen.ts",
    "fix:format": "oxfmt .",
    "fix:lint": "oxlint --type-aware --fix .",
    "prepack": "bun run build",
    "release:major": "bun pm version major --no-git-tag-version",
    "release:minor": "bun pm version minor --no-git-tag-version",
    "release:patch": "bun pm version patch --no-git-tag-version",
    "test": "bun run build && bun run compile && bun test ./src"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.1.1",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@octokit/graphql-schema": "15.26.1",
    "@octokit/openapi-types": "29.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "effect": "4.1.1",
    "graphql": "17.0.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.4"
}
