{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  enabled: true,
  // config:recommended turns the dashboard on, and this object merges with it.
  dependencyDashboard: {
    // Lists the CVEs that osvVulnerabilityAlerts can't raise a PR for, as no fix exists.
    osvVulnerabilitySummary: "unresolved",
  },
  osvVulnerabilityAlerts: true,
  timezone: "Europe/London",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    // Reads the `# renovate:` comment above a workflow's `…_VERSION` value.
    "customManagers:githubActionsVersions",
  ],
  lockFileMaintenance: {
    enabled: true,
    commitMessagePrefix: "[{{manager}}]",
    branchTopic: "lock-file-maintenance-{{manager}}",
    // Renovate's default window, before 4am on Monday, is narrow enough to miss a run.
    schedule: ["after 5:30am and before 5:30pm on wednesday"],
  },
  // The same age as bunfig.toml's `minimumReleaseAge`. With a shorter one, bun refuses the version
  // and the PR's install fails.
  minimumReleaseAge: "3 days",
  // Renovate's default. A group's branch opens with only its members that are minimumReleaseAge
  // old, and the rest join later. So a new @effect/platform-* paired with an older effect fails
  // at install until every member is old enough. Wait for that, rather than pin versions or
  // relax minimumReleaseAge.
  internalChecksFilter: "strict",
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  schedule: ["after 11:30am and before 5:30pm every weekday"],
  rangeStrategy: "pin",
  // Otherwise Renovate switches to semantic titles while "<word>: <text>" subjects are most of
  // main's last 20 commits. It finds closed PRs by title, so each switch reopens ignored updates.
  semanticCommits: "disabled",
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)package\\.json$/"],
      matchStrings: ['"packageManager":\\s*"bun@(?<currentValue>[^"]+)"'],
      depNameTemplate: "bun",
      datasourceTemplate: "npm",
      packageNameTemplate: "bun",
    },
    {
      // mise's own version
      customType: "regex",
      managerFilePatterns: ["/(^|/)mise\\.toml$/"],
      matchStrings: ['min_version = \\{ soft = "(?<currentValue>[^"]+)" \\}'],
      depNameTemplate: "jdx/mise",
      datasourceTemplate: "github-releases",
    },
    {
      // Renovate's mise manager skips the `http` backend.
      customType: "regex",
      managerFilePatterns: ["/(^|/)mise\\.toml$/"],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) packageName=(?<packageName>\\S+)\\s+version = "(?<currentValue>[^"]+)"',
      ],
    },
  ],
  packageRules: [
    {
      // bun resolves to the newest itself, so there's no age to gate.
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: null,
      prBodyNotes: [
        "⚠️ minimumReleaseAge doesn't apply to lock file maintenance — check release age yourself before merging.",
      ],
    },
    {
      // Off: without a mise.lock, mise stays portable across environments.
      matchManagers: ["mise"],
      matchUpdateTypes: ["lockFileMaintenance"],
      enabled: false,
    },
    {
      // Release age isn't wired into replacements yet: https://github.com/renovatebot/renovate/issues/39400
      matchUpdateTypes: ["replacement"],
      minimumReleaseAge: null,
      prBodyNotes: [
        "⚠️ minimumReleaseAge doesn't apply to replacements — check release age yourself before merging.",
      ],
    },
    {
      // A pin fixes a range to the already-resolved version.
      matchUpdateTypes: ["pin"],
      minimumReleaseAge: null,
    },
    {
      // engines states the oldest supported runtime, raised by hand, which "pin" would replace
      // with the newest.
      matchDepTypes: ["engines"],
      enabled: false,
    },
    {
      matchPackageNames: ["@types/bun", "bun", "oven-sh/bun"],
      groupName: "bun",
    },
    {
      matchPackageNames: ["effect", "@effect/**"],
      groupName: "effect",
    },
    {
      // oxlint-tsgolint embeds the TypeScript compiler its version names: 7.0.2001 is
      // TypeScript 7.0.2, patch 1. @effect/tsgo runs its own build of the installed TypeScript, or
      // silently its latest build where it lacks one. Bumping one alone checks against a compiler
      // the others don't run. This rule comes after effect's, so @effect/tsgo joins this group, not
      // effect's.
      matchPackageNames: ["@effect/tsgo", "oxlint-tsgolint", "typescript"],
      groupName: "TypeScript",
    },
    {
      matchSourceUrls: ["https://github.com/oxc-project/oxc"],
      groupName: "oxc",
    },
  ],
}
