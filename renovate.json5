{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  enabled: true,
  dependencyDashboard: {
    osvVulnerabilitySummary: 'unresolved',
  },
  osvVulnerabilityAlerts: true,
  timezone: 'Europe/London',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    'customManagers:githubActionsVersions',
  ],
  lockFileMaintenance: {
    enabled: true,
    commitMessagePrefix: '[{{manager}}]',
    branchTopic: 'lock-file-maintenance-{{manager}}',
    schedule: [
      'after 5:30am and before 5:30pm on wednesday',
    ],
  },
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  schedule: [
    'after 11:30am and before 5:30pm every weekday',
  ],
  rangeStrategy: 'pin',
  semanticCommits: 'disabled',
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)package\\.json$/',
      ],
      matchStrings: [
        '"packageManager":\\s*"bun@(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'bun',
      datasourceTemplate: 'npm',
      packageNameTemplate: 'bun',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)mise\\.toml$/',
      ],
      matchStrings: [
        'min_version = \\{ soft = "(?<currentValue>[^"]+)" \\}',
      ],
      depNameTemplate: 'jdx/mise',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)mise\\.toml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) packageName=(?<packageName>\\S+)\\s+version = "(?<currentValue>[^"]+)"',
      ],
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'lockFileMaintenance',
      ],
      minimumReleaseAge: null,
      prBodyNotes: [
        "⚠️ minimumReleaseAge doesn't apply to lock file maintenance — check release age yourself before merging.",
      ],
    },
    {
      matchManagers: [
        'mise',
      ],
      matchUpdateTypes: [
        'lockFileMaintenance',
      ],
      enabled: false,
    },
    {
      matchUpdateTypes: [
        'replacement',
      ],
      minimumReleaseAge: null,
      prBodyNotes: [
        "⚠️ minimumReleaseAge doesn't apply to replacements — check release age yourself before merging.",
      ],
    },
    {
      matchUpdateTypes: [
        'pin',
      ],
      minimumReleaseAge: null,
    },
    {
      matchDepTypes: [
        'engines',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        '@types/bun',
        'bun',
        'oven-sh/bun',
      ],
      groupName: 'bun',
    },
    {
      matchPackageNames: [
        'effect',
        '@effect/**',
      ],
      groupName: 'effect',
    },
    {
      matchPackageNames: [
        'oxlint-tsgolint',
        'typescript',
      ],
      groupName: 'TypeScript',
    },
    {
      matchSourceUrls: [
        'https://github.com/oxc-project/oxc',
      ],
      groupName: 'oxc',
    },
  ],
}
